# Generated by Ansible from roles/openwrt/templates/msmtprc.j2. Do not edit on the router.
# Used by openwrt-safe-upgrade to send the nightly report. The file is mode 0600
# because it holds the SMTP password.
defaults
auth           on
tls            on
tls_starttls   {{ 'on' if openwrt_auto_update_smtp_port | int == 587 else 'off' }}
tls_trust_file /etc/ssl/certs/ca-certificates.crt

account        default
host           {{ openwrt_auto_update_smtp_host }}
port           {{ openwrt_auto_update_smtp_port }}
from           {{ openwrt_auto_update_from }}
user           {{ openwrt_auto_update_smtp_user }}
password       "{{ openwrt_auto_update_smtp_password }}"
