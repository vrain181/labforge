#!/bin/sh
# Generated by Ansible from roles/openwrt/templates/safe_upgrade.sh.j2. Do not edit on the router.
#
# Nightly package upgrade that leaves held-back packages alone (kernel, netifd,
# firewall4, ...). It mails the report only when something happened: a package
# was upgraded, a held-back package has an update, or a step failed.
#
# Cron runs it. It never runs a bare `apk upgrade`: every upgrade names the
# packages it may change. If a simulated upgrade would also change a held-back
# package (through a dependency), nothing is upgraded.

# Patterns are matched with `case`, so the shell must not expand them as globs.
set -f

# shellcheck disable=SC2086
held={{ openwrt_auto_update_held_packages | join(' ') | quote }}
mail_to={{ openwrt_auto_update_notify_to | quote }}
mail_from={{ openwrt_auto_update_from | quote }}
log_tag=openwrt-safe-upgrade

work=$(mktemp -d /tmp/safe-upgrade.XXXXXX) || exit 1
trap 'rm -rf "$work"' EXIT
: > "$work/report"

note() {
  echo "$*" >> "$work/report"
  logger -t "$log_tag" -- "$*"
}

notify() {
  [ -s "$work/report" ] || return 0
  {
    echo "To: $mail_to"
    echo "From: $mail_from"
    echo "Subject: [$(uname -n)] package update report"
    echo "Date: $(date -R)"
    echo
    cat "$work/report"
  } | msmtp -C /etc/msmtprc -t || logger -t "$log_tag" -- "could not send the report email"
}

fail() {
  note "FAILED: $*"
  notify
  exit 1
}

# apk names a package name-version. The version starts at the first "-" that
# is followed by a digit.
name_of() {
  sed 's/-[0-9].*$//'
}

is_held() {
  for pattern in $held; do
    # shellcheck disable=SC2254
    case "$1" in
      $pattern) return 0 ;;
    esac
  done
  return 1
}

# `safe_upgrade.sh --test` sends a test mail and does nothing else.
if [ "${1:-}" = "--test" ]; then
  note "Test mail from openwrt-safe-upgrade. Mail works."
  notify
  exit 0
fi

# 1. Refresh the index. Nothing is upgraded if this fails.
if ! apk update > "$work/update" 2>&1; then
  cat "$work/update" >> "$work/report"
  fail "apk update"
fi

# 2. Split the upgradable packages into safe and held-back lists.
apk list -u > "$work/list" 2>/dev/null || fail "apk list -u"
awk 'NF && $1 !~ /:$/ { print $1 }' "$work/list" | name_of > "$work/upgradable"
: > "$work/safe"
: > "$work/held"
while read -r pkg; do
  if is_held "$pkg"; then
    echo "$pkg" >> "$work/held"
  else
    echo "$pkg" >> "$work/safe"
  fi
done < "$work/upgradable"

if [ -s "$work/held" ]; then
  note "Held back, upgrade by hand: $(tr '\n' ' ' < "$work/held")"
fi

# 3. Simulate the safe upgrade. A held-back name in the simulation means a
#    dependency would change it, so the whole upgrade is skipped.
if [ -s "$work/safe" ]; then
  xargs -r apk upgrade --simulate < "$work/safe" > "$work/simulate" 2>&1 || fail "simulating the upgrade"
  blocked=$(tr -s ' \t' '\n' < "$work/simulate" | name_of | while read -r word; do
    is_held "$word" && echo "$word"
  done | sort -u | tr '\n' ' ')

  if [ -n "$blocked" ]; then
    note "Skipped the safe upgrade: it would also change held-back packages ($blocked)."
  else
    # 4. Upgrade only the named safe packages. xargs -r skips the call when
    #    the list is empty, so a bare `apk upgrade` cannot run here.
    if xargs -r apk upgrade < "$work/safe" > "$work/upgrade" 2>&1; then
      note "Upgraded: $(tr '\n' ' ' < "$work/safe")"
    else
      cat "$work/upgrade" >> "$work/report"
      fail "apk upgrade"
    fi
  fi
fi

notify
exit 0
