#!/bin/sh
# Generated by Ansible from roles/openwrt/templates/safe_upgrade.sh.j2. Do not edit on the router.
#
# Nightly package upgrade that leaves held-back packages alone (kernel, netifd,
# firewall4, ...). It mails the report only when something happened: a package
# was upgraded, a held-back package has an update, or a step failed.
#
# Cron runs it. It never runs a bare `apk upgrade`: every upgrade names the
# packages it may change. If a simulated upgrade would also change a held-back
# package (through a dependency), nothing is upgraded.

# Patterns are matched with `case`, so the shell must not expand them as globs.
set -f

# shellcheck disable=SC2086
held={{ openwrt_auto_update_held_packages | join(' ') | quote }}
mail_to={{ openwrt_auto_update_notify_to | quote }}
mail_from={{ openwrt_auto_update_from | quote }}
log_tag=openwrt-safe-upgrade

work=$(mktemp -d /tmp/safe-upgrade.XXXXXX) || exit 1
trap 'rm -rf "$work"' EXIT
: > "$work/report"
: > "$work/changes"

note() {
  echo "$*" >> "$work/report"
  logger -t "$log_tag" -- "$*"
}

html_escape() {
  sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g' \
    -e 's/"/\&quot;/g' -e "s/'/\&#39;/g"
}

write_html_report() {
  {
    printf '<!doctype html><html><body style="font-family:Arial,sans-serif;color:#222">\n'
    printf '<h2>OpenWrt package update report</h2>\n'
    if [ -s "$work/changes" ]; then
      printf '<table border="1" cellpadding="6" cellspacing="0" style="border-collapse:collapse">\n'
      printf '<thead><tr><th align="left">Package</th><th align="left">Previous version</th><th align="left">Updated version</th></tr></thead><tbody>\n'
      tab=$(printf '\t')
      while IFS="$tab" read -r package old_version new_version; do
        printf '<tr><td>%s</td><td>%s</td><td>%s</td></tr>\n' \
          "$(printf '%s' "$package" | html_escape)" \
          "$(printf '%s' "$old_version" | html_escape)" \
          "$(printf '%s' "$new_version" | html_escape)"
      done < "$work/changes"
      printf '</tbody></table>\n'
    else
      printf '<p>No package version changes were detected.</p>\n'
    fi
    printf '<h3>Details</h3><pre style="white-space:pre-wrap">\n'
    html_escape < "$work/report"
    printf '</pre></body></html>\n'
  } > "$work/report.html"
}

notify() {
  [ -s "$work/report" ] || return 0
  write_html_report
  boundary="----=_OpenWrt_$(date +%s)_$$"
  {
    echo "To: $mail_to"
    echo "From: $mail_from"
    echo "Subject: [$(uname -n)] package update report"
    echo "Date: $(date -R)"
    echo 'MIME-Version: 1.0'
    echo "Content-Type: multipart/alternative; boundary=\"$boundary\""
    echo
    echo "--$boundary"
    echo 'Content-Type: text/plain; charset=UTF-8'
    echo 'Content-Transfer-Encoding: 8bit'
    echo
    cat "$work/report"
    echo
    echo "--$boundary"
    echo 'Content-Type: text/html; charset=UTF-8'
    echo 'Content-Transfer-Encoding: 8bit'
    echo
    cat "$work/report.html"
    echo
    echo "--$boundary--"
  } | msmtp -C /etc/msmtprc -t || logger -t "$log_tag" -- "could not send the report email"
}

fail() {
  note "FAILED: $*"
  notify
  exit 1
}

record_changes() {
  apk list --installed --manifest > "$work/after" || return 1
  awk '
    NR == FNR { old[$1] = $2; next }
    ($1 in old) && old[$1] != $2 { print $1 "\t" old[$1] "\t" $2 }
    !($1 in old) { print $1 "\t(not installed)\t" $2 }
  ' "$work/before" "$work/after" > "$work/changes"
}

# apk names a package name-version. The version starts at the first "-" that
# is followed by a digit.
name_of() {
  sed 's/-[0-9].*$//'
}

is_held() {
  for pattern in $held; do
    # shellcheck disable=SC2254
    case "$1" in
      $pattern) return 0 ;;
    esac
  done
  return 1
}

# `safe_upgrade.sh --test` sends a test mail and does nothing else.
if [ "${1:-}" = "--test" ]; then
  note "Test mail from openwrt-safe-upgrade. Mail works."
  notify
  exit 0
fi

# 1. Refresh the index. Nothing is upgraded if this fails.
if ! apk update > "$work/update" 2>&1; then
  cat "$work/update" >> "$work/report"
  fail "apk update"
fi

# 2. Split the upgradable packages into safe and held-back lists.
apk list -u > "$work/list" 2>/dev/null || fail "apk list -u"
awk 'NF && $1 !~ /:$/ { print $1 }' "$work/list" | name_of > "$work/upgradable"
: > "$work/safe"
: > "$work/held"
while read -r pkg; do
  if is_held "$pkg"; then
    echo "$pkg" >> "$work/held"
  else
    echo "$pkg" >> "$work/safe"
  fi
done < "$work/upgradable"

if [ -s "$work/held" ]; then
  note "Held back, upgrade by hand: $(tr '\n' ' ' < "$work/held")"
fi

# 3. Simulate the safe upgrade. A held-back name in the simulation means a
#    dependency would change it, so the whole upgrade is skipped.
if [ -s "$work/safe" ]; then
  xargs -r apk upgrade --simulate < "$work/safe" > "$work/simulate" 2>&1 || fail "simulating the upgrade"
  blocked=$(tr -s ' \t' '\n' < "$work/simulate" | name_of | while read -r word; do
    is_held "$word" && echo "$word"
  done | sort -u | tr '\n' ' ')

  if [ -n "$blocked" ]; then
    note "Skipped the safe upgrade: it would also change held-back packages ($blocked)."
  else
    # Capture installed versions before and after the transaction so the report
    # reflects actual changes, including dependencies upgraded by apk.
    apk list --installed --manifest > "$work/before" || fail "reading installed package versions before upgrade"

    # 4. Upgrade only the named safe packages. xargs -r skips the call when
    #    the list is empty, so a bare `apk upgrade` cannot run here.
    if xargs -r apk upgrade < "$work/safe" > "$work/upgrade" 2>&1; then
      record_changes || fail "reading installed package versions after upgrade"
      if [ -s "$work/changes" ]; then
        note "Package upgrades (name: previous version -> updated version):"
        tab=$(printf '\t')
        while IFS="$tab" read -r package old_version new_version; do
          note "$package: $old_version -> $new_version"
        done < "$work/changes"
      else
        note "No package version changes were detected."
      fi
    else
      cat "$work/upgrade" >> "$work/report"
      record_changes || :
      fail "apk upgrade"
    fi
  fi
fi

notify
exit 0
