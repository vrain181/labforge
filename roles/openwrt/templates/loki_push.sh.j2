#!/bin/sh
# Generated by Ansible from roles/openwrt/templates/loki_push.sh.j2. Do not edit on the router.
#
# Started detached by loki_start.yml for one playbook run. It forwards the
# router's log lines to Grafana Cloud Loki until loki_stop.yml removes the token
# file. Lines before this run's start marker are skipped, so old buffer content
# is not sent again.
#
# Labels on each line:
#   job      openwrt
#   host     openwrt_loki_host
#   app      openwrt-ansible for role steps, otherwise the syslog tag of the daemon
#   step     role step (run, stage, approve, commit, apply, rollback, record,
#            report), or system for daemons
#   package  UCI package a step worked on (network, firewall, ...), or none
#
# Role steps log with the tag owrt.<step>[.<package>]. Busybox cuts syslog tags at
# 31 characters, so the prefix is short. Push errors are logged under openwrt-loki
# and are not forwarded, so a failing push cannot feed itself. Lines from Ansible's
# own modules (tag ansible-*) are not forwarded either.
#
# The log buffer is read once a second. Every poll is sent as one request, so a
# burst of log lines does not queue one request per line.
url={{ openwrt_loki_url | quote }}
user={{ openwrt_loki_user | quote }}
host={{ openwrt_loki_host | quote }}
token_file={{ openwrt_loki_token_file | quote }}
run_id={{ openwrt_loki_run_id | quote }}
work_dir={{ openwrt_work_dir | quote }}

[ -n "$url" ] && [ -s "$token_file" ] || exit 0
command -v curl >/dev/null 2>&1 || {
  logger -t openwrt-loki -- "curl is missing; Loki push not started"
  exit 1
}

# JSON strings need backslashes and double quotes escaped. Tabs and carriage
# returns become spaces.
json_escape() {
  sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' | tr '\t\r' '  '
}

# Sends the streams collected since the last poll in one request. The
# credentials go to curl through a config on stdin, so they stay out of the
# process list. A push that is not accepted is logged with its HTTP status.
batch=""
send_batch() {
  [ -n "$batch" ] || return 0
  code=$(printf 'user = "%s:%s"\n' "$user" "$(cat "$token_file")" |
    curl -sS -m 10 -o /dev/null -w '%{http_code}' -K - -H 'Content-Type: application/json' \
      --data-binary "{\"streams\":[${batch%,}]}" "$url" 2>/dev/null) || code=000
  [ "$code" = 204 ] || logger -t openwrt-loki -- "push to Loki failed: HTTP $code"
  batch=""
}

# The start marker is logged here, not by the caller. It must come after the
# reader below has started, or the marker is missed and nothing is forwarded.
( sleep 1; logger -t owrt.run -- "started run=$run_id" ) &

# Each poll prints the lines after the last line seen, then a @@poll line that
# ends the batch. `logread -f` is not used: its output is buffered in a pipe.
seen="$work_dir/logread.seen"
now="$work_dir/logread.now"
rm -f "$seen"
{
  while [ -s "$token_file" ]; do
    logread > "$now"
    if [ -s "$seen" ]; then
      last=$(cat "$seen")
      n=$(grep -n -F -x -- "$last" "$now" | tail -n 1 | cut -d: -f1)
      if [ -n "$n" ]; then
        tail -n "+$((n + 1))" "$now"
      else
        cat "$now"
      fi
    else
      cat "$now"
    fi
    tail -n 1 "$now" > "$seen"
    echo '@@poll'
    sleep 1
  done
  rm -f "$seen" "$now"
} | awk -v run="$run_id" '
  function clean(s) {
    gsub(/[^A-Za-z0-9_.-]/, "_", s)
    return s
  }
  BEGIN {
    started = 0
    month_count = split("Jan Feb Mar Apr May Jun Jul Aug Sep Oct Nov Dec", months, " ")
  }
  $0 == "@@poll" { print "@@poll"; fflush(); next }
  {
    # The first five fields are "<weekday> <month> <day> <time> <year>". They become
    # the event time, which Loki gets instead of the time the line was sent.
    split($0, head, " ")
    for (m = 1; m <= month_count; m++) if (months[m] == head[2]) month = sprintf("%02d", m)
    event = head[5] "-" month "-" sprintf("%02d", head[3]) " " head[4]

    line = $0
    for (i = 1; i <= 6; i++) sub(/^ *[^ ]+ */, "", line)
    tag = line
    sub(/:.*$/, "", tag)
    sub(/\[.*$/, "", tag)
    msg = line
    sub(/^[^:]*: ?/, "", msg)
    if (tag == "owrt.run" && msg == "started run=" run) started = 1
    if (!started || msg == "" || tag ~ /^openwrt-loki/ || tag ~ /^ansible-/) next
    app = tag
    step = "system"
    pkg = "none"
    if (tag ~ /^owrt\./) {
      n = split(tag, parts, ".")
      app = "openwrt-ansible"
      step = parts[2]
      if (n >= 3) pkg = parts[3]
    }
    print clean(app) "|" clean(step) "|" clean(pkg) "|" event "|" msg
    fflush()
  }
' | while IFS='|' read -r app step package event message; do
  if [ "$app" = '@@poll' ]; then
    send_batch
    continue
  fi
  # busybox date reads the event time in the router's time zone, the same one
  # logread uses. If it cannot parse the time, the line is sent with the current time.
  ts=$(date -d "$event" +%s 2>/dev/null) || ts=$(date +%s)
  escaped=$(printf '%s' "$message" | json_escape)
  labels="{\"job\":\"openwrt\",\"host\":\"$host\",\"app\":\"$app\",\"step\":\"$step\",\"package\":\"$package\"}"
  batch="$batch{\"stream\":$labels,\"values\":[[\"${ts}000000000\",\"$escaped\"]]},"
done
