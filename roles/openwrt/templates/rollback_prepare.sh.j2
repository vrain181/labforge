#!/bin/sh
# Generated by Ansible from roles/openwrt/templates/rollback_prepare.sh.j2. Do not edit on the router.
#
# Runs before a network/firewall commit. It:
#   1. creates a fresh snapshot directory,
#   2. copies every protected config file into it,
#   3. starts rollback_timer.sh in the background, which restores the snapshot
#      unless the operator confirms reachability in time.
#
# Output: RUN_DIR=<snapshot directory>, then ARMED. Ansible reads both lines.
set -e

base={{ openwrt_rollback_state_dir | quote }}
mkdir -p "$base"
run=$(mktemp -d "$base/run.XXXXXX")

# 1. Back up each protected package. A package without a config file gets an
#    empty .absent marker, so the timer deletes the file instead of restoring it.
{% for package in openwrt_rollback_packages %}
if [ -f {{ ('/etc/config/' ~ package) | quote }} ]; then
  cp -p {{ ('/etc/config/' ~ package) | quote }} "$run/{{ package }}"
else
  : > "$run/{{ package }}.absent"
fi
{% endfor %}

# 2. Start the timer detached from this SSH session, so it outlives the connection.
nohup sh {{ openwrt_work_dir | quote }}/rollback_timer.sh "$run" </dev/null >/dev/null 2>&1 &
pid=$!
printf '%s\n' "$pid" > "$run/pid"

# 3. If the timer did not start, remove the snapshot and fail the run.
kill -0 "$pid" 2>/dev/null || {
  rm -rf "$run"
  exit 1
}

echo "RUN_DIR=$run"
echo ARMED
