#!/bin/sh
# Generated by Ansible from roles/openwrt/templates/rollback_confirm.sh.j2. Do not edit on the router.
#
# Runs when the operator confirms that the router is reachable after a
# network/firewall commit. It marks the snapshot as confirmed, stops the timer,
# and deletes the snapshot, so nothing is rolled back.
#
# Output: CONFIRMED on success. Any other exit code means the timer may already
# have started a rollback. Each step is logged to syslog with tag owrt.rollback.
state={{ openwrt_rollback_run_dir | quote }}

# Writes one syslog line. The Loki push forwards it with labels from the tag.
note() {
  logger -t "owrt.$1" -- "$2"
}

# 1. The snapshot must still exist. If it is gone, the timer already ran.
[ -d "$state" ] || {
  note rollback "confirmation refused: snapshot is missing, so the timer already ran"
  echo 'Rollback state directory is missing.' >&2
  exit 1
}

# 2. Take the lock. If the timer holds it, the rollback has already started.
mkdir "$state/lock" 2>/dev/null || {
  note rollback "confirmation refused: rollback already started"
  echo 'Rollback already started; configuration was not confirmed.' >&2
  exit 1
}

# 3. Write the confirmed marker atomically. Without it, the timer would restore.
marker="$state/confirmed.tmp.$$"
if ! { : > "$marker" && mv -f "$marker" "$state/confirmed"; }; then
  rmdir "$state/lock" 2>/dev/null || true
  note rollback "confirmation failed: could not write the confirmed marker"
  exit 1
fi

# 4. Stop the timer.
if [ -s "$state/pid" ]; then
  kill "$(cat "$state/pid")" 2>/dev/null || true
fi
sleep 1

# 5. Remove the lock and the snapshot.
rmdir "$state/lock" 2>/dev/null || true
note rollback "confirmed by the operator; timer stopped and snapshot removed"
rm -rf "$state"
echo CONFIRMED
